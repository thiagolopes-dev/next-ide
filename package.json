{
  "name": "next-ide",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop IDE to run many Claude Code sessions across projects side by side, in one window",
  "license": "MIT",
  "author": "Thiago Lopes",
  "homepage": "https://github.com/thiagolopes-dev/next-ide",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiagolopes-dev/next-ide.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:dictation && electron-vite dev",
    "build": "npm run build:dictation && electron-vite build",
    "build:dictation": "node scripts/build-dictation.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true; node scripts/brand-electron.mjs || true",
    "brand": "node scripts/brand-electron.mjs",
    "package": "npm run build:dictation && node scripts/fetch-koffi-x64.mjs && electron-vite build && electron-builder --dir",
    "app": "open dist/mac-arm64/next-ide.app",
    "dist": "npm run build:dictation && node scripts/fetch-koffi-x64.mjs && electron-vite build && electron-builder",
    "screenshots": "electron-vite build && playwright test -c scripts/screenshots/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "koffi": "3.3.2",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "diff": "9.0.0",
    "dockview-react": "8.3.0",
    "electron": "44.3.0",
    "electron-builder": "26.0.12",
    "electron-vite": "5.0.0",
    "ignore": "7.0.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  }
}
